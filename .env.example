# Local development defaults for Docker Compose and the Spring Boot app.
# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=computerstore
MYSQL_USER=computerstore
MYSQL_PASSWORD=computerstore
MYSQL_ROOT_PASSWORD=rootpassword
SERVER_PORT=8080

# Authentication.
# JWT_SECRET is required; the application refuses to start without it and there is no
# fallback in source. Generate your own and keep it out of version control:
#   openssl rand -base64 48
# Minimum 32 characters (256 bits) for HS256.
JWT_SECRET=
# ISO-8601 duration for access token lifetime, e.g. PT15M, PT1H.
JWT_EXPIRATION=PT1H

# Development-only admin bootstrap. Used only when the app runs with the `local` profile,
# and skipped when either value is empty. Choose a password locally; never commit one.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
